# ~/.bashrc: executed by bash(1) for non-login interactive shells.

# Keep this file portable. Put machine-specific or temporary settings in
# ~/.bashrc.local; this file sources it at the end.

# If not running interactively, don't do anything
case $- in
    *i*) ;;
    *) return ;;
esac

# global functions
[ -f "$HOME/.bash_functions" ] && . "$HOME/.bash_functions"

# Customize the prompt and history behavior
[ -f "$HOME/.bash_prompt" ] && . "$HOME/.bash_prompt"

# Put extra aliases in ~/.bash_aliases instead of adding them here directly.
[ -f "$HOME/.bash_aliases" ] && . "$HOME/.bash_aliases"

# Completions.
# Enable programmable completion features when bash-completion is installed.
if ! shopt -oq posix; then
    if [ -f /usr/share/bash-completion/bash_completion ]; then
        . /usr/share/bash-completion/bash_completion
    elif [ -f /etc/bash_completion ]; then
        . /etc/bash_completion
    fi
fi
# Grok CLI completions (binaries are symlinked into ~/.local/bin).
[ -r "$HOME/.grok/completions/bash/grok.bash" ] && . "$HOME/.grok/completions/bash/grok.bash"

# Toolchains.
# Cargo/Rust.
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# Homebrew. Check common Linux, Apple Silicon macOS, and Intel macOS paths.
if [ -x /home/linuxbrew/.linuxbrew/bin/brew ]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
elif [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x /usr/local/bin/brew ]; then
    eval "$(/usr/local/bin/brew shellenv)"
fi

# nvm.
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && . "$NVM_DIR/bash_completion"

# OpenSSL paths needed by some native Rust builds on Debian/Ubuntu x86_64.
if [ -d /usr/lib/x86_64-linux-gnu ]; then
    export OPENSSL_DIR=/usr
    export OPENSSL_LIB_DIR=/usr/lib/x86_64-linux-gnu
    export PKG_CONFIG_PATH="/usr/lib/x86_64-linux-gnu/pkgconfig:/usr/share/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
fi

# User-local executables.
path_append "$HOME/.local/bin"

# Deno/Fabric.
[ -d "$HOME/.deno/bin" ] && path_append "$HOME/.deno/bin"

# Yarn global binaries.
if command -v yarn >/dev/null 2>&1; then
    path_append "$(yarn global bin 2>/dev/null)"
fi

# WSL-only behavior.
if is_wsl; then
    remove_wsl_windows_paths
fi

# docker — do NOT set DOCKER_HOST, let Docker Desktop manage the context
# setting DOCKER_HOST overrides context and routes to a standalone daemon that Docker Desktop cannot see
# Docker contexts should decide where the CLI connects, especially on WSL where Docker Desktop manages this.

# SDKMAN expects its init script to run near the end so it can adjust PATH.
export SDKMAN_DIR="$HOME/.sdkman"
[ -s "$SDKMAN_DIR/bin/sdkman-init.sh" ] && . "$SDKMAN_DIR/bin/sdkman-init.sh"

# Secrets from pass (https://www.passwordstore.org/), when this machine has it set up.
if command -v pass >/dev/null 2>&1; then
    # GitHub Packages registry token; gh CLI picks it up via GH_TOKEN.
    SPOT_GH_REGISTRY_TOKEN=$(pass show github/token 2>/dev/null)
    if [ -n "$SPOT_GH_REGISTRY_TOKEN" ]; then
        export SPOT_GH_REGISTRY_TOKEN
        export GH_TOKEN=$SPOT_GH_REGISTRY_TOKEN
    fi

    SPOT_CASTLEIO=$(pass show spot/castleio 2>/dev/null)
    [ -n "$SPOT_CASTLEIO" ] && export SPOT_CASTLEIO

    # Datadog (headless pup CLI).
    DD_API_KEY=$(pass show spot/datadog/api 2>/dev/null)
    DD_APP_KEY=$(pass show spot/datadog/app 2>/dev/null)
    if [ -n "$DD_API_KEY" ]; then
        export DD_API_KEY DD_APP_KEY DD_SITE=datadoghq.com
    fi
fi

# Unmanaged, per-machine settings go here.
[ -f "$HOME/.bashrc.local" ] && . "$HOME/.bashrc.local"
